{
  "name": "api-himno",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/generate-d1-seed.mjs",
    "db:local": "wrangler d1 execute DB --local --file=d1-seed.sql",
    "db:remote": "wrangler d1 execute DB --remote --file=d1-seed.sql"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.2",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.131.2"
  }
}
